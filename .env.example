# === Deployment Configuration ===
# RPC endpoint for deployment (Sepolia or Mainnet)
# For Sepolia: https://ethereum-sepolia-rpc.publicnode.com
# For Mainnet: https://eth.llamarpc.com
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=

# (Optional) Executor address for BundleExecutor contract
# If not provided, will use the address derived from PRIVATE_KEY
EXECUTOR_ADDRESS=

# (Optional) Initial WETH amount to deposit (in wei)
# Example: 1000000000000000000 = 1 ETH
INITIAL_WETH_AMOUNT=0

# (Optional) Custom WETH address for other chains
# Leave empty to use default addresses for Mainnet/Sepolia
WETH_ADDRESS=

# === Runtime Configuration ===
# Ethereum RPC endpoint (cannot be same as Flashbots RPC)
ETHEREUM_RPC_URL=http://127.0.0.1:8545

# Private key for the EOA submitting transactions
PRIVATE_KEY=

# Address of deployed BundleExecutor contract
BUNDLE_EXECUTOR_ADDRESS=

# (Optional) Key for signing Flashbots submissions
# If not provided, will use default relay signing key
FLASHBOTS_RELAY_SIGNING_KEY=

# (Optional) Percentage of profit to send to miner (default: 80)
MINER_REWARD_PERCENTAGE=80

# (Optional) URL to hit after successful bundle submission
HEALTHCHECK_URL=

# (Optional) Log level: DEBUG, INFO, WARN, ERROR (default: INFO)
LOG_LEVEL=INFO

# (Optional) Dry run mode - simulate bundle submission without actually sending
# DEFAULT: true (safe mode)
# Set to "false" to enable LIVE mode and actually submit bundles
# WARNING: Only set to "false" when you're ready to submit real bundles!
DRY_RUN=true