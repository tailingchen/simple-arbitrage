# Ethereum RPC endpoint (cannot be same as Flashbots RPC)
ETHEREUM_RPC_URL=http://127.0.0.1:8545

# Private key for the EOA submitting transactions
PRIVATE_KEY=

# Address of deployed BundleExecutor contract
BUNDLE_EXECUTOR_ADDRESS=

# (Optional) Key for signing Flashbots submissions
# If not provided, will use default relay signing key
FLASHBOTS_RELAY_SIGNING_KEY=

# (Optional) Percentage of profit to send to miner (default: 80)
MINER_REWARD_PERCENTAGE=80

# (Optional) URL to hit after successful bundle submission
HEALTHCHECK_URL=