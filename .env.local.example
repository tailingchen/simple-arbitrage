# Local Fork Testing Configuration
# Copy this to .env.local for testing with Anvil fork

# === Fork Configuration ===
# Local Anvil RPC endpoint
FORK_RPC_URL=http://127.0.0.1:8545

# Anvil test account #0
# Address: 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Use same executor as deployer for testing
EXECUTOR_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Initial WETH amount (1 ETH in wei)
INITIAL_WETH_AMOUNT=1000000000000000000

# === Runtime Configuration ===
# Use local fork for runtime
ETHEREUM_RPC_URL=http://127.0.0.1:8545

# Bundle executor address (will be set after deployment)
BUNDLE_EXECUTOR_ADDRESS=

# Use a dummy key for Flashbots (not needed for local testing)
FLASHBOTS_RELAY_SIGNING_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Miner reward percentage
MINER_REWARD_PERCENTAGE=80

# Log level for local testing (DEBUG shows everything)
LOG_LEVEL=DEBUG